# GitLab Configuration (required)
GITLAB_TOKEN=your_gitlab_personal_access_token
GITLAB_PROJECT_ID=your_project_id
GITLAB_API_URL=https://gitlab.com/api/v4

# AI Provider Selection (optional, default: gemini)
# Supported: gemini, openai_compatible, openrouter
AI_PROVIDER=gemini

# =============================================================================
# GEMINI CONFIGURATION (required if AI_PROVIDER=gemini)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# GENERIC OPENAI-COMPATIBLE CONFIGURATION (required if AI_PROVIDER=openai_compatible)
# Works with any OpenAI-compatible API endpoint
# =============================================================================
# Base URL for the API (required)
OPENAI_COMPATIBLE_BASE_URL=https://api.together.ai/v1

# API key for authentication (required)
OPENAI_COMPATIBLE_API_KEY=your_api_key

# Model identifier (required)
OPENAI_COMPATIBLE_MODEL=meta-llama/Llama-3-70b

# Optional custom headers as JSON (for special auth or tracking)
# OPENAI_COMPATIBLE_HEADERS={"X-Custom-Header":"value"}

# -----------------------------------------------------------------------------
# Example configurations for popular providers:
# -----------------------------------------------------------------------------
# Together AI:
#   OPENAI_COMPATIBLE_BASE_URL=https://api.together.xyz/v1
#   OPENAI_COMPATIBLE_MODEL=meta-llama/Llama-3-70b-chat-hf
#
# Groq:
#   OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_COMPATIBLE_MODEL=llama3-70b-8192
#
# Ollama (local):
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPATIBLE_MODEL=llama3
#   OPENAI_COMPATIBLE_API_KEY=ollama  # Ollama doesn't require a real key
#
# OpenAI:
#   OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
#   OPENAI_COMPATIBLE_MODEL=gpt-4
# -----------------------------------------------------------------------------

# =============================================================================
# OPENROUTER CONFIGURATION (required if AI_PROVIDER=openrouter)
# Convenience preset - uses openai_compatible internally with OpenRouter defaults
# Get your API key from https://openrouter.ai/keys
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: For OpenRouter rankings/analytics
OPENROUTER_SITE_URL=https://your-site.com
OPENROUTER_APP_NAME=gitlab-mr-ai
